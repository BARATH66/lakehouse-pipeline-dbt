	partition FactCustomerChurn = m
		mode: import
		source =
				let
				    Source = Sql.Database(ServerName, DatabaseName),
				    Gold = Source{[Schema = "gold", Item = "fct_customer_churn"]}[Data],
				    Selected = Table.SelectColumns(Gold, {"customer_id", "contract_type", "internet_service", "payment_method", "tenure_months", "tenure_band", "monthly_charges", "total_charges", "months_billed", "ltv", "is_churned", "is_active"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"customer_id", type text}, {"contract_type", type text}, {"internet_service", type text}, {"payment_method", type text}, {"tenure_months", Int64.Type}, {"tenure_band", type text}, {"monthly_charges", Currency.Type}, {"total_charges", Currency.Type}, {"months_billed", Int64.Type}, {"ltv", Currency.Type}, {"is_churned", Int64.Type}, {"is_active", Int64.Type}}),
				    WithOrder = Table.AddColumn(Typed, "tenure_band_order", each if [tenure_months] <= 12 then 1 else if [tenure_months] <= 24 then 2 else if [tenure_months] <= 48 then 3 else 4, Int64.Type)
				in
				    WithOrder

	annotation PBI_ResultType = Table

