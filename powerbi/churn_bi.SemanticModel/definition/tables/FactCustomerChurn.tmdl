table FactCustomerChurn
	lineageTag: a1b2c3d4-0002-4a5b-8c6d-7e8f9a0b1c02

	measure Customers = COUNTROWS(FactCustomerChurn)
		formatString: #,0
		displayFolder: Descriptive
		lineageTag: a02c8b0a-fa05-4b64-a03f-94c41d27a669

	measure 'Active Customers' = SUM(FactCustomerChurn[is_active])
		formatString: #,0
		displayFolder: Descriptive
		lineageTag: 61844b42-ceaa-4d0a-94cf-69385d3a4751

	measure 'Churned Customers' = SUM(FactCustomerChurn[is_churned])
		formatString: #,0
		displayFolder: Descriptive
		lineageTag: cd23bc29-e9bd-488e-b51b-c5c3f7a18a99

	measure 'Churn Rate' = DIVIDE([Churned Customers], [Customers])
		formatString: 0.0%
		displayFolder: Descriptive
		lineageTag: 36c4082a-495b-4844-bd68-cf3836702a6e

	measure 'Total LTV' = SUM(FactCustomerChurn[ltv])
		formatString: #,0
		displayFolder: Descriptive
		lineageTag: ebde1a96-a0bb-4746-8afb-b6870b8424d4

	measure 'Avg LTV' = DIVIDE([Total LTV], [Customers])
		formatString: #,0.00
		displayFolder: Descriptive
		lineageTag: fa63edbf-9d6a-4ac4-ad77-2992d9c4750e

	measure 'Avg Monthly Charges' = AVERAGE(FactCustomerChurn[monthly_charges])
		formatString: #,0.00
		displayFolder: Descriptive
		lineageTag: 42605074-55e1-4cad-8c9f-d52c43a65ac6

	measure 'Avg Tenure (months)' = AVERAGE(FactCustomerChurn[tenure_months])
		formatString: 0.0
		displayFolder: Descriptive
		lineageTag: 41b926c1-0076-480e-9717-9aad86a8f2b7

	/// Monthly recurring revenue from customers who have not churned.
	measure 'MRR Active' = CALCULATE(SUM(FactCustomerChurn[monthly_charges]), FactCustomerChurn[is_active] = 1)
		formatString: #,0
		displayFolder: Descriptive
		lineageTag: 1069fe2e-5067-43f3-8287-96d477d25816

	/// Monthly recurring revenue that left with churned customers.
	measure 'MRR Lost' = CALCULATE(SUM(FactCustomerChurn[monthly_charges]), FactCustomerChurn[is_churned] = 1)
		formatString: #,0
		displayFolder: Descriptive
		lineageTag: 837ecc5c-9217-4c9d-b7fb-8278ac67cc73

	measure 'Overall Churn Rate' = CALCULATE([Churn Rate], REMOVEFILTERS())
		formatString: 0.0%
		displayFolder: Diagnostic
		lineageTag: 01aa544e-14be-4676-b2ce-2fa914b8b305

	/// How far a segment's churn rate is above or below the overall rate.
	measure 'Churn Rate Gap (pts)' = [Churn Rate] - [Overall Churn Rate]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Diagnostic
		lineageTag: b79ada81-1640-44bc-946d-ed719830f003

	/// Share of all churned customers that fall in the current segment.
	measure 'Share of Churners' = DIVIDE([Churned Customers], CALCULATE([Churned Customers], REMOVEFILTERS()))
		formatString: 0.0%
		displayFolder: Diagnostic
		lineageTag: a6abf6de-445f-47f0-a9c8-5a0eb6416646

